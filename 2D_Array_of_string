#include <stdio.h>
#include <stdlib.h>

int allocate_memory(int rows, int columns, char *array[rows][columns])
{
    for (int row = 0; row < rows; row++)
    {
        for (int column = 0; column < columns; column++)
        {
            array[row][column] = (char *)malloc(50 * sizeof(char));
            if (array[row][column] == NULL)
            {
                printf("Memory allocation failed at [%d][%d]!\n", row, column);
                return 0;
            }
        }
    }
    return 1;
}

void free_memory(int rows, int columns, char *array[rows][columns])
{
    for (int row = 0; row < rows; row++)
    {
        for (int column = 0; column < columns; column++)
        {
            free(array[row][column]);
            array[row][column] = NULL;
        }
    }
}

int is_vowel(char character)
{
    return (character == 'a' || character == 'e' || character == 'i' || character == 'o' || character == 'u' ||
            character == 'A' || character == 'E' || character == 'I' || character == 'O' || character == 'U');
}

int string_length(char *string)
{
    int length = 0;
    while (string[length] != '\0')
    {
        length++;
    }
    return length;
}

void input_words(int rows, int columns, char *array[rows][columns])
{
    printf("Enter the words for the grid:\n");
    for (int row = 0; row < rows; row++)
    {
        for (int column = 0; column < columns; column++)
        {
            printf("Enter word for position [%d][%d]: ", row + 1, column + 1);
            scanf("%s", array[row][column]);
        }
    }
}

void display_words(int rows, int columns, char *array[rows][columns])
{
    printf("\nWords in the grid:\n");
    for (int row = 0; row < rows; row++)
    {
        for (int column = 0; column < columns; column++)
        {
            printf("%s ", array[row][column]);
        }
        printf("\n");
    }
}

int count_start_from_vowel_words(int rows, int columns, char *array[rows][columns])
{
    int vowel_count = 0;
    for (int row = 0; row < rows; row++)
    {
        for (int column = 0; column < columns; column++)
        {
            if (is_vowel(array[row][column][0]))
            {
                vowel_count++;
            }
        }
    }
    return vowel_count;
}

void find_longest_word(int rows, int columns, char *array[rows][columns], int *longest_word_row, int *longest_word_column)
{
    int max_length = 0;
    for (int row = 0; row < rows; row++)
    {
        for (int column = 0; column < columns; column++)
        {
            int current_length = string_length(array[row][column]);
            if (current_length > max_length)
            {
                max_length = current_length;
                *longest_word_row = row;
                *longest_word_column = column;
            }
        }
    }
}

int main()
{
    int rows, columns;
    printf("Enter the number of rows: ");
    scanf("%d", &rows);
    printf("Enter the number of columns: ");
    scanf("%d", &columns);

    char *array[rows][columns];

    if (!allocate_memory(rows, columns, array))
    {
        printf("Program terminated due to memory allocation failure.\n");
        return 1;
    }

    input_words(rows, columns, array);

    display_words(rows, columns, array);

    int vowel_count = count_start_from_vowel_words(rows, columns, array);
    printf("\nNumber of words starting with a vowel: %d\n", vowel_count);

    int longest_word_row = -1, longest_word_column = -1;
    find_longest_word(rows, columns, array, &longest_word_row, &longest_word_column);
    if (longest_word_row != -1 && longest_word_column != -1)
    {
        printf("Longest word: %s (at position [%d][%d])\n", array[longest_word_row][longest_word_column], longest_word_row + 1, longest_word_column + 1);
    }

    free_memory(rows, columns, array);
    return 0;
}
